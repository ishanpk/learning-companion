rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write their own documents based on the userId in the path
    // For this prototype, we allow access if the ID matches the one generated by the client
    match /studypal_users/{userId} {
      allow read, write: if true; 
      // Note: In production, use Firebase Auth and check request.auth.uid == userId
    }
  }
}
