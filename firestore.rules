rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read/write their own document
    match /studypal_users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Fallback: allow anonymous users to access their own doc
      // (matched by the localStorage-generated ID passed as userId)
      allow read, write: if true;
      // TODO: Remove the permissive rule above once Firebase Auth is
      // fully integrated. The `request.auth.uid == userId` rule above
      // will then be the sole access control mechanism.
    }

    // Deny access to all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
