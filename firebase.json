{
  "hosting": {
    "source": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "frameworksBackend": {
      "region": "us-central1"
    }
  },
  "auth": {
    "includeStackTraces": true,
    "blockingFunctions": {},
    "providers": {
      "anonymous": {
        "enabled": true
      }
    }
  }
}
